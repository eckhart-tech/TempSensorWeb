<VirtualHost *:80>
    ServerName neptune.vm.tornadovps.net
    ServerAlias neptune.vm.tornadovps.net
    ServerAdmin webmaster@neptune.vm.tornadovps.net

    # static part
    DocumentRoot /var/www/TempSensor
    Alias /favicon.ico /var/www/TempSensor/favicon.ico
    Alias / /var/www/TempSensor/
    <Directory /var/www/TempSensor>
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined
</VirtualHost>