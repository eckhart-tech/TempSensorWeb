
LogLevel info
#WSGIPythonPath /usr/local/src
#WSGIRestrictStdout Off

<VirtualHost *:80>
    ServerName neptune.vm.tornadovps.net
    ServerAlias neptune.vm.tornadovps.net
    ServerAdmin webmaster@neptune.vm.tornadovps.net

    # static part
    DocumentRoot /var/www/TempSensor
    Alias /favicon.ico /var/www/TempSensor/favicon.ico
    Alias /temp/ /var/www/TempSensor/
    <Directory /var/www/TempSensor>
        Require all granted
    </Directory>

    # dynamic part

    WSGIDaemonProcess site.com processes=1 threads=15 display-name=%{GROUP} python-path=/usr/local/src
    WSGIProcessGroup site.com
    WSGIScriptAlias /rest /usr/local/src/web/application.wsgi

    <Directory /usr/local/src/web>
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined

    RewriteEngine on
    RewriteMap    hosts-deny  "txt:/etc/apache2/blacklist"
    RewriteCond   "${hosts-deny:%{REMOTE_ADDR}|NOT-FOUND}" "!=NOT-FOUND" [OR]
    RewriteCond   "${hosts-deny:%{REMOTE_HOST}|NOT-FOUND}" "!=NOT-FOUND"
    RewriteRule .* - [F]
</VirtualHost>
